---
qemu-system-riscv64 \
  -machine virt \
  -cpu rv64 \
  -m 2G \
  -smp 1 \
  -nographic \
  -bios default \
  -kernel dqib_riscv64-virt/kernel \
  -initrd dqib_riscv64-virt/initrd \
  -append "root=LABEL=rootfs console=ttyS0" \
  -drive file=./dqib_riscv64-virt/image.qcow2,format=qcow2,if=virtio \
  -netdev user,id=net0 -device virtio-net-device,netdev=net0 \
  -device virtio-9p-device,fsdev=fs1,mount_tag=host_share \
  -fsdev local,security_model=none,id=fs1,path=/home/debian/riscv-coremark/
  
(in guest)
mkdir -p /mnt/host
mount -t 9p -o trans=virtio,version=9p2000.L host_share /mnt/host
